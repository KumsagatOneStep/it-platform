APP_ENV=local
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/it_platform
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=local-development-secret-do-not-use-in-production
COOKIE_SECURE=false
COMPANY_TIMEZONE=Europe/Moscow
# Сети/адреса доверенных обратных прокси — JSON-список. Только от них учитывается
# X-Forwarded-For. В Docker укажите сеть, из которой приходит прокси, например:
# TRUSTED_PROXIES=["172.16.0.0/12"]
TRUSTED_PROXIES=["127.0.0.1/32", "::1/128"]
